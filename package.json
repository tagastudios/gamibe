{
  "name": "gamibe-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Gamibe · Vue 3 PWA finance dashboard (Firebase) plus archived Next.js/T3 workspace.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter gamibe dev",
    "build": "pnpm --filter gamibe build",
    "lint": "pnpm --filter gamibe lint",
    "dev:gamibe": "pnpm --filter gamibe dev",
    "build:gamibe": "pnpm --filter gamibe build",
    "lint:gamibe": "pnpm --filter gamibe lint",
    "typecheck:gamibe": "pnpm --filter gamibe type-check",
    "preview:gamibe": "pnpm --filter gamibe preview",
    "dev:legacy": "pnpm --filter gamibe-legacy dev",
    "build:legacy": "pnpm --filter gamibe-legacy build",
    "lint:legacy": "pnpm --filter gamibe-legacy lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tagastudios/gamibe.git"
  },
  "author": "Jose Tannous",
  "license": "ISC"
}
